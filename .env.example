# Docker Container Backup Manager - Konfigurationsbeispiel
# Kopiere diese Datei zu .env und passe die Werte an

# Anwendung
DEBUG=False
APP_NAME=Docker Container Backup Manager
APP_VERSION=1.0.0

# Paths
BACKUP_DIR=./backups
LOGS_DIR=./logs

# Docker
DOCKER_SOCKET=unix:///var/run/docker.sock
DOCKER_TIMEOUT=30

# Backup Settings
MAX_BACKUP_SIZE=10737418240
BACKUP_RETENTION_DAYS=30
COMPRESS_LEVEL=6

# Scheduler
SCHEDULER_TIMEZONE=UTC
SCHEDULER_MAX_WORKERS=4

# Upload
MAX_UPLOAD_SIZE=5368709120

# Server
HOST=0.0.0.0
PORT=8000
